#!/bin/bash
# A fake nvidia-smi for the vLLM #69058 kit's offline test, answering the two queries run.sh makes.
# FAKE_NVSMI=hang makes it never return, as a driver in a bad state can.
[ "${FAKE_NVSMI:-}" = hang ] && exec sleep 3600
case "$*" in
  *--query-gpu*) printf 'name, memory.total [MiB], driver_version\nNVIDIA A10G, 23028 MiB, 580.95.05\n' ;;
  -L) echo "GPU 0: NVIDIA A10G (UUID: GPU-00000000-0000-0000-0000-000000000000)" ;;
  *) echo "fake nvidia-smi: unexpected arguments $*" >&2; exit 1 ;;
esac
