{
  "apiVersion": "platform.lkhun9311.github.io/v1",
  "kind": "MLTrainingJob",
  "metadata": {
    "name": "train-qualify",
    "namespace": "train-a"
  },
  "spec": {
    "queue": "gpu-train-a",
    "image": "cpu-ddp:torch251",
    "gpuCount": 1,
    "distributed": {
      "worldSize": 2
    },
    "command": [
      "sh",
      "-c",
      "exec python -c 'import sys, torch; sys.exit(0 if torch.cuda.is_available() else 3)'"
    ]
  }
}
