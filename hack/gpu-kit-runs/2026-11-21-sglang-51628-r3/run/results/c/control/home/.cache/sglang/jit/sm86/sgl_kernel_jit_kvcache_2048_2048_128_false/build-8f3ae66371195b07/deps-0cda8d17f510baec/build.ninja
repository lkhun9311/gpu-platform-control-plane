ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc
cxxflags = -fPIC -std=c++20 -O3 -I/opt/sglang/lib/python3.12/site-packages/tvm_ffi/include -I/sgl-workspace/sglang/python/sglang/kernels/jit/include
cudaflags = -Xcompiler -fPIC -gencode=arch=compute_86,code=sm_86 -DSGL_CUDA_ARCH=860 -std=c++20 -O3 --expt-relaxed-constexpr -I/opt/sglang/lib/python3.12/site-packages/tvm_ffi/include -I/sgl-workspace/sglang/python/sglang/kernels/jit/include
ldflags = -shared -L/opt/sglang/lib/python3.12/site-packages/tvm_ffi/lib -ltvm_ffi -L/usr/local/cuda/lib64 -lcudart

rule compile_cxx
  depfile = $out.d
  command = $cxx -MD -MF "$out.d" $cxxflags -c "$in" -o "$out"

rule compile_cuda
  depfile = $out.d
  command = $nvcc -MD -MF "$out.d" $cudaflags -c "$in" -o "$out"

rule link
  command = $cxx $in $ldflags -o "$out"

build cuda_0.o: compile_cuda cuda.cu

build sgl_kernel_jit_kvcache_2048_2048_128_false.so: link cuda_0.o

default sgl_kernel_jit_kvcache_2048_2048_128_false.so
