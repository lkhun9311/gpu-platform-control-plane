+BLOCK_SIZE = 16
+NUM_HEADS = 1
+HEAD_DIM = 4
+NUM_GPU_BLOCKS = DEFAULT_MAX_IO_ENTRIES + 2
+# One float32 layer per page.
+PAGE_BYTES = NUM_HEADS * BLOCK_SIZE * HEAD_DIM * 4
+NUM_FILE_PAGES = 16
+
