+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.third_party.flash_linear_attention.ops.index import (
+    prepare_chunk_indices,
+    prepare_chunk_offsets,
+)
+
+CHUNK_SIZE = 64
+
+
+@pytest.mark.parametrize("dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize(
+    "seq_lens",
+    [
+        [5, 0, 70],
+        [0, 70],
+        [64, 0, 0, 66],
+        [70, 0],
+        [1, 64, 65, 128],
+        [0, 0],
+    ],
+)
+def test_chunk_indices_keep_ids_of_empty_sequences(
+    seq_lens: list[int], dtype: torch.dtype
+):
+    """A zero-length sequence owns no chunk but keeps its id (#68414).
+    The chunks of later sequences must not take it over.
+    The row index of chunk i of sequence s must equal chunk_offsets[s] + i."""
+    cu_seqlens = torch.tensor([0, *seq_lens]).cumsum(0, dtype=dtype)
+    chunk_indices = prepare_chunk_indices(cu_seqlens, CHUNK_SIZE)
+    chunk_offsets = prepare_chunk_offsets(cu_seqlens, CHUNK_SIZE)
+
+    expected = [
+        [seq, chunk]
+        for seq, seq_len in enumerate(seq_lens)
+        for chunk in range(-(-seq_len // CHUNK_SIZE))
+    ]
+    assert chunk_indices.dtype == cu_seqlens.dtype
+    assert chunk_indices.device == cu_seqlens.device
+    assert chunk_indices.shape == (len(expected), 2)
+    assert chunk_indices.tolist() == expected
+    for row, (seq, chunk) in enumerate(expected):
+        assert chunk_offsets[seq].item() + chunk == row
