+				{id: "bg-b", cost: 600, dur: 1000 * ms, pinPod: "b"},
+				{id: "r", arrive: 0, cost: 500, dur: 300 * ms},
+			}
+			res := newSim(t, cfg, a, reqs).run("fragmentation"+v.suffix(a), 0)
+			record(t, res)
