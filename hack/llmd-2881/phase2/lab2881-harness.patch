+package inflightload
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	fwkrh "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/requesthandling"
+)
+
+// Lab test for llm-d-router#2881 Phase 2, not for upstream.
+// Two concurrent requests that share one request id, both routed to the same endpoint.
+// PluginState is keyed by request id, and Write replaces an entry without evicting it, so the first entry's
+// counters are never rolled back.
+func TestLab2881DuplicateRequestIDSameEndpoint(t *testing.T) {
+	producer := newTestProducer(t)
+	ctx := context.Background()
+	endpointName := "dup-endpoint"
+	endpointID := fullEndpointName(endpointName)
+
+	first := makeTokenRequest("dup", 4)
+	second := makeTokenRequest("dup", 4)
+	res1, res2 := makeSchedulingResult(endpointName), makeSchedulingResult(endpointName)
+	require.NoError(t, producer.PreRequest(ctx, first, res1))
+	require.NoError(t, producer.PreRequest(ctx, second, res2))
+	require.Equal(t, int64(2), producer.requestTracker.get(endpointID))
+
+	first.SchedulingResult, second.SchedulingResult = res1, res2
+	producer.ResponseBody(ctx, first, &fwkrh.Response{EndOfStream: true}, nil)
+	producer.ResponseBody(ctx, second, &fwkrh.Response{EndOfStream: true}, nil)
+
+	t.Logf("after both completed: requests=%d tokens=%d",
+		producer.requestTracker.get(endpointID), producer.tokenTracker.get(endpointID))
+	// Recorded outcome, asserted so a change in behaviour is noticed: one request and its tokens stay counted.
+	require.Equal(t, int64(1), producer.requestTracker.get(endpointID))
+	require.Equal(t, int64(4)+UnknownOutputTokens, producer.tokenTracker.get(endpointID))
+}
+
+// The same with the two requests on different endpoints: the state keys differ, so nothing is replaced, but the
+// first completion's Delete evicts both entries while the second request is still running.
+func TestLab2881DuplicateRequestIDDifferentEndpoints(t *testing.T) {
+	producer := newTestProducer(t)
+	ctx := context.Background()
+	a, b := "dup-a", "dup-b"
+
+	first := makeTokenRequest("dup", 4)
+	second := makeTokenRequest("dup", 4)
+	res1, res2 := makeSchedulingResult(a), makeSchedulingResult(b)
+	require.NoError(t, producer.PreRequest(ctx, first, res1))
+	require.NoError(t, producer.PreRequest(ctx, second, res2))
+
+	first.SchedulingResult = res1
+	producer.ResponseBody(ctx, first, &fwkrh.Response{EndOfStream: true}, nil)
+	t.Logf("after the first completed, the second still running: b requests=%d", producer.requestTracker.get(fullEndpointName(b)))
+	// Recorded outcome: the still-running second request is no longer counted on b.
+	require.Equal(t, int64(0), producer.requestTracker.get(fullEndpointName(b)))
+}
