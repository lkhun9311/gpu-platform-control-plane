+// variant is one setting of the re-queue bounds and wake rule; baseline and #3173 run only under the first.
+type variant struct {
+	wake        wake
+	maxAttempts int
+}
+
+func variants() []variant {
+	return []variant{
+		{wakeOnCapacity, 5}, {wakeOneOnCapacity, 5}, {wakeOnSample, 5}, {wakeOneOnCapacity, 20},
+	}
+}
+
+func (v variant) applies(a arm) bool {
+	return a == armRequeue || a == armTryReserve || v == variants()[0]
+}
+
+func (v variant) apply(c simConfig) simConfig {
+	c.wake, c.maxAttempts = v.wake, v.maxAttempts
+	return c
+}
+
+func (v variant) suffix(a arm) string {
+	if a == armBaseline || a == arm3173 {
+		return ""
+	}
+	return fmt.Sprintf(" [%s, %d attempts]", v.wake, v.maxAttempts)
+}
