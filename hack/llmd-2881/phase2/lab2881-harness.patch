+// S6: cancellations while queued, held after a re-queue, between reservation and PreRequest, and while running.
+// Duplicate ids are covered by the producer test in inflightload and by the detector check below.
+func TestLab2881Cancellation(t *testing.T) {
+	for _, a := range allArms {
