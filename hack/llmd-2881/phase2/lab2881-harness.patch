+func TestMain(m *testing.M) {
+	code := m.Run()
+	if out := os.Getenv("LAB2881_OUT"); out != "" && len(labResults) > 0 {
+		b, _ := json.MarshalIndent(labResults, "", " ")
+		_ = os.WriteFile(out, b, 0o644)
+	}
+	os.Exit(code)
+}
