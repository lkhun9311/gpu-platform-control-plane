+// S7: two EPP replicas over the same three pods, each learning the other's load every 50 ms.
+// Requests alternate between replicas, as a load balancer in front of two EPPs would send them.
+func TestLab2881TwoReplicas(t *testing.T) {
+	for _, a := range allArms {
