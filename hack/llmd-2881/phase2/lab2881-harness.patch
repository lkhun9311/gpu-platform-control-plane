+func baseCfg() simConfig {
+	return simConfig{mode: modeTokens, maxReq: 100, maxTok: 1024, pods: []string{"a", "b", "c"},
+		releaseToFilt: 4 * ms, filtToPreReq: ms / 2, rankToReserve: ms / 20, maxAttempts: 5, maxAge: 5000 * ms,
+		backoff: 200 * ms, wake: wakeOnCapacity, samplePeriod: 100 * ms}
+}
+
+var labResults []result
+
+func record(t *testing.T, r result) {
+	t.Helper()
+	b, _ := json.Marshal(r)
+	t.Logf("%s", b)
+	labResults = append(labResults, r)
+	if r.Balance["pending_dispatches_at_end"].(int64) != 0 || len(r.Balance["load_left_at_end"].([]string)) != 0 {
+		t.Errorf("%s/%s leaked a reservation or load: %v", r.Scenario, r.Arm, r.Balance)
+	}
+}
