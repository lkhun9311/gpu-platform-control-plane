+package concurrency
+
+// Lab harness for llm-d-router#2881 Phase 2: local, for a design decision, not for upstream.
+//
+// It drives main's real detector (Saturation, Filter, admits, ReserveDispatch, ReleaseDispatch) through a
+// discrete-event simulation in virtual microseconds.
+// The flow-control gate, the release-to-filter and filter-to-PreRequest delays, re-queue and endpoint reservation are
+// modelled here, in this file; none of them is the EPP's own code path.
+// Virtual time makes every interleaving deterministic: an event at the same instant runs in insertion order.
+// Flow control is modelled as main runs it: one dispatch cycle on each arrival and on a 1 ms ticker, and at most one
+// release per cycle (processor.go:237 and :278).
+// The barriers around filter evaluation and PreRequest are those delays: moving a second request's arrival across
+// them selects which of the two runs first.
+
+import (
+	"container/heap"
+	"context"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/go-logr/logr"
+
+	"github.com/llm-d/llm-d-router/pkg/epp/framework/interface/datalayer"
+	fwksched "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/scheduling"
+	attrconcurrency "github.com/llm-d/llm-d-router/pkg/epp/framework/plugins/datalayer/attribute/concurrency"
+)
+
+type arm string
+
+const (
+	armBaseline   arm = "baseline"
+	arm3173       arm = "pr3173-model"
+	armRequeue    arm = "requeue"
+	armTryReserve arm = "tryreserve"
+)
+
+var allArms = []arm{armBaseline, arm3173, armRequeue, armTryReserve}
+
+const ms = int64(1000)
+
+type wake string
+
+const (
+	// wakeOnCapacity holds a re-queued request until some endpoint's load drops, or the backoff passes.
+	wakeOnCapacity wake = "capacity-change"
+	// wakeOnSample holds it until the next saturation sample, whether or not anything changed.
+	wakeOnSample wake = "next-sample"
+	// wakeOneOnCapacity hands each drop in load to the oldest held request only, so held requests do not all retry.
+	wakeOneOnCapacity wake = "capacity-change-oldest-only"
+)
+
+type simConfig struct {
+	mode          concurrencyMode
+	maxReq        int64
+	maxTok        int64
+	pods          []string
+	releaseToFilt int64 // release to filter evaluation: on main this includes tokenization.
+	filtToPreReq  int64 // filter evaluation to the PreRequest that counts the load.
+	rankToReserve int64 // tryreserve only: ranking to the reservation attempt.
+	maxAttempts   int
+	maxAge        int64 // re-queue bound on time since the original enqueue.
+	backoff       int64 // re-queue fallback wake when no capacity change arrives.
+	wake          wake
+	samplePeriod  int64
+	replicas      int   // EPP replicas; above 1 each sees the others' load only at sync ticks.
+	syncPeriod    int64 // interval at which a replica learns the other replicas' load.
+	// sameWindow keeps the #3173 model on the configured release-to-filter delay with no preparation time.
+	// Otherwise the PR's preparation is charged before the request becomes eligible, and release to filter is 100 us,
+	// because the PR tokenizes while the request is queued.
+	sameWindow bool
+}
+
+type simReq struct {
+	id       string
+	arrive   int64
+	cost     int64 // tokens charged by the detector's policy: prompt plus max_tokens.
+	dur      int64
+	cands    []string // endpoints the request's metadata selects; nil means every pod.
+	cancelAt int64
+	pinPod   string // a pinned request starts already running on this pod, at time 0.
+	replica  int
+
+	// State.
+	enq              int64
+	attempts         int
+	held             bool
+	heldAt           int64
+	queued           bool
+	dispatchReserved bool
+	tokReserved      bool
+	pod              string
+	running          bool
+	done             bool
+	outcome          int
+	finalRelease     int64
+	doneAt           int64
+	preparedAt       int64
+}
+
+type event struct {
+	at   int64
+	seq  int
+	kind string
+	r    *simReq
+}
+
+type eventQ []*event
+
+func (q eventQ) Len() int { return len(q) }
+func (q eventQ) Less(i, j int) bool {
+	if q[i].at != q[j].at {
+		return q[i].at < q[j].at
+	}
+	return q[i].seq < q[j].seq
+}
+func (q eventQ) Swap(i, j int) { q[i], q[j] = q[j], q[i] }
+func (q *eventQ) Push(x any)   { *q = append(*q, x.(*event)) }
+func (q *eventQ) Pop() any {
+	old := *q
+	e := old[len(old)-1]
+	*q = old[:len(old)-1]
+	return e
+}
+
+type replica struct {
+	// Each replica has its own flow-control queue and dispatch loop, as separate EPP instances do.
+	queue []*simReq
+	det   *detector
+	reg   *localRegistry
+	own   map[string]*attrconcurrency.InFlightLoad
+	snap  map[string]*attrconcurrency.InFlightLoad
+}
+
+type sim struct {
+	t       *testing.T
+	cfg     simConfig
+	arm     arm
+	now     int64
+	seq     int
+	events  eventQ
+	rr      int // round-robin counter for equal-load ties, as the max-score picker rotates them (picker.go:108).
+	reqs    []*simReq
+	reps    []*replica
+	truth   map[string]*attrconcurrency.InFlightLoad
+	ctx     context.Context
+	reserve int // ReserveDispatch calls that returned true
+	release int // ReleaseDispatch calls that returned true
+	// Overshoot on the true load: tokens above the limit on a pod running more than one request.
+	overMax      int64
+	overSince    map[string]int64
+	overDuration int64
+	gateEvals    int
+	filterEvals  int
+	conflicts    int
+}
+
+func newSim(t *testing.T, cfg simConfig, a arm, reqs []*simReq) *sim {
+	if cfg.replicas == 0 {
+		cfg.replicas = 1
+	}
+	s := &sim{t: t, cfg: cfg, arm: a, reqs: reqs, truth: map[string]*attrconcurrency.InFlightLoad{},
+		overSince: map[string]int64{}, ctx: context.Background()}
+	for i := 0; i < cfg.replicas; i++ {
+		c := config{mode: cfg.mode, maxConcurrency: cfg.maxReq, maxTokenConcurrency: cfg.maxTok, failClosed: true}
+		rp := &replica{det: newDetector(fmt.Sprintf("lab-%d", i), c, logr.Discard()), reg: newLocalRegistry(),
+			own: map[string]*attrconcurrency.InFlightLoad{}, snap: map[string]*attrconcurrency.InFlightLoad{}}
+		for _, p := range cfg.pods {
+			rp.own[p], rp.snap[p] = &attrconcurrency.InFlightLoad{}, &attrconcurrency.InFlightLoad{}
+		}
+		s.reps = append(s.reps, rp)
+	}
+	for _, p := range cfg.pods {
+		s.truth[p] = &attrconcurrency.InFlightLoad{}
+	}
+	return s
+}
+
+func (s *sim) push(at int64, kind string, r *simReq) {
+	s.seq++
+	heap.Push(&s.events, &event{at: at, seq: s.seq, kind: kind, r: r})
+}
+
+func (s *sim) rep(r *simReq) *replica { return s.reps[r.replica%len(s.reps)] }
+
+// sync rewrites one replica's registry as its own load plus its last snapshot of the others.
+func (s *sim) sync(rp *replica) {
+	for _, p := range s.cfg.pods {
+		o, sn := rp.own[p], rp.snap[p]
+		rp.reg.update(fullEndpointName(p), func(l *attrconcurrency.InFlightLoad) {
+			l.Requests, l.Tokens = o.Requests+sn.Requests, o.Tokens+sn.Tokens
+		})
+	}
+}
+
+func (s *sim) snapshotAll() {
+	for i, rp := range s.reps {
+		for _, p := range s.cfg.pods {
+			var n, k int64
+			for j, other := range s.reps {
+				if j != i {
+					n += other.own[p].Requests
+					k += other.own[p].Tokens
+				}
+			}
+			rp.snap[p].Requests, rp.snap[p].Tokens = n, k
+		}
+		s.sync(rp)
+	}
+}
+
+// addLoad changes one replica's own count on a pod and the true load, then re-checks overshoot.
+func (s *sim) addLoad(rp *replica, pod string, dn, dk int64) {
+	rp.own[pod].Requests += dn
+	rp.own[pod].Tokens += dk
+	s.truth[pod].Requests += dn
+	s.truth[pod].Tokens += dk
+	s.sync(rp)
+	s.trackOvershoot(pod)
+}
+
+func (s *sim) trackOvershoot(pod string) {
+	l := s.truth[pod]
+	var over int64
+	if (s.cfg.mode == modeTokens || s.cfg.mode == modeHybrid) && l.Requests > 1 && l.Tokens > s.cfg.maxTok {
+		over = l.Tokens - s.cfg.maxTok
+	}
+	if (s.cfg.mode == modeRequests || s.cfg.mode == modeHybrid) && l.Requests > s.cfg.maxReq {
+		over = max(over, l.Requests-s.cfg.maxReq)
+	}
+	since, was := s.overSince[pod]
+	switch {
+	case over > 0 && !was:
+		s.overSince[pod] = s.now
+	case over == 0 && was:
+		s.overDuration += s.now - since
+		delete(s.overSince, pod)
+	}
+	s.overMax = max(s.overMax, over)
+}
+
+func (s *sim) cands(r *simReq) []string {
+	if r.cands != nil {
+		return r.cands
+	}
+	return s.cfg.pods
+}
+
+func (s *sim) poolEndpoints(rp *replica) []datalayer.Endpoint {
+	var out []datalayer.Endpoint
+	for _, p := range s.cfg.pods {
+		out = append(out, newFakeEndpoint(rp.reg, p))
+	}
+	return out
+}
+
+func (s *sim) schedEndpoints(rp *replica, r *simReq) []fwksched.Endpoint {
+	var out []fwksched.Endpoint
+	for _, p := range s.cands(r) {
+		e := newStubSchedulingEndpoint(rp.reg, p)
+		e.incomingTokens = r.cost
+		out = append(out, e)
+	}
+	return out
+}
+
+func (s *sim) filter(rp *replica, r *simReq) []string {
+	s.filterEvals++
+	var out []string
+	for _, e := range rp.det.Filter(s.ctx, nil, s.schedEndpoints(rp, r)) {
+		out = append(out, e.GetMetadata().ID.Name)
+	}
+	return out
+}
+
+// gate is the flow-control release decision for the request at the head of the queue.
+func (s *sim) gate(r *simReq) bool {
+	s.gateEvals++
+	rp := s.rep(r)
+	// Main's dispatch cycle measures saturation over the whole pool, not the request's candidates (processor.go:490).
+	if rp.det.Saturation(s.ctx, s.poolEndpoints(rp)) >= 1 {
+		return false
+	}
+	// The #3173 model refuses release until preparation is done (processor.go requestFits in the PR).
+	if s.arm == arm3173 && s.now < r.preparedAt {
+		return false
+	}
+	// It then asks whether some candidate the request's metadata selects admits its projected cost.
+	if s.arm == arm3173 && len(s.filter(rp, r)) == 0 {
+		return false
+	}
+	return true
+}
+
+func (s *sim) finish(r *simReq, code int) {
+	if r.done {
+		s.t.Fatalf("%s finished twice", r.id)
+	}
+	r.done, r.outcome, r.doneAt = true, code, s.now
+	s.removeFromQueue(r)
+}
+
+func (s *sim) removeFromQueue(r *simReq) {
+	if !r.queued {
+		return
+	}
+	r.queued = false
+	rp := s.rep(r)
+	for i, q := range rp.queue {
+		if q == r {
+			rp.queue = append(rp.queue[:i], rp.queue[i+1:]...)
+			return
+		}
+	}
+}
+
+func (s *sim) releaseDispatch(r *simReq) {
+	if !r.dispatchReserved {
+		return
+	}
+	r.dispatchReserved = false
+	if s.rep(r).det.ReleaseDispatch(r.id) {
+		s.release++
+	}
+}
+
+func (s *sim) enqueue(r *simReq) {
+	r.queued = true
+	rp := s.rep(r)
+	rp.queue = append(rp.queue, r)
+	// Re-queued requests keep their original enqueue time, so the queue stays ordered by first arrival.
+	sort.SliceStable(rp.queue, func(i, j int) bool { return rp.queue[i].enq < rp.queue[j].enq })
+}
+
+func (s *sim) requeueArm() bool { return s.arm == armRequeue || s.arm == armTryReserve }
+
+// dispatchCycle releases at most the head of one replica's single flow, if the gate admits it.
+// A held request is skipped, so the requests behind it can pass while it waits.
+func (s *sim) dispatchCycle(rp *replica) {
+	var head *simReq
+	for _, q := range rp.queue {
+		if !q.held {
+			head = q
+			break
+		}
+	}
+	if head == nil {
+		return
+	}
+	// The re-queue designs bound waiting by time as well as attempts, whether or not the request was ever rejected.
+	if s.requeueArm() && s.now-head.enq >= s.cfg.maxAge {
+		s.finish(head, 429)
+		return
+	}
+	if !s.gate(head) {
+		return
+	}
+	{
+		s.removeFromQueue(head)
+		head.attempts++
+		head.finalRelease = s.now
+		if s.rep(head).det.ReserveDispatch(head.id) {
+			head.dispatchReserved = true
+			s.reserve++
+		}
+		window := s.cfg.releaseToFilt
+		if s.arm == arm3173 && !s.cfg.sameWindow {
+			window = min(window, ms/10)
+		}
+		s.push(s.now+window, "filter", head)
+	}
+}
+
+// reject handles an attempt whose endpoint set came back empty, or whose reservation lost a race.
+func (s *sim) reject(r *simReq) {
+	s.releaseDispatch(r)
+	if s.arm == armBaseline || s.arm == arm3173 {
+		s.finish(r, 503)
+		return
+	}
+	if r.attempts >= s.cfg.maxAttempts || s.now-r.enq >= s.cfg.maxAge {
+		s.finish(r, 429)
+		return
+	}
+	r.held, r.heldAt = true, s.now
+	s.enqueue(r)
+	if (s.cfg.wake == wakeOnCapacity || s.cfg.wake == wakeOneOnCapacity) && s.cfg.backoff > 0 {
+		s.push(s.now+s.cfg.backoff, "backoff", r)
+	}
+}
+
+// wakeHeld acts on the replica whose own view of capacity changed.
+func (s *sim) wakeHeld(rp *replica, reason wake) {
+	if reason == wakeOnCapacity && s.cfg.wake == wakeOneOnCapacity {
+		// The queue is ordered by original enqueue time, so the first held request is the oldest.
+		for _, q := range rp.queue {
+			if q.held {
+				q.held = false
+				return
+			}
+		}
+		return
+	}
+	if s.cfg.wake != reason {
+		return
+	}
+	for _, q := range rp.queue {
+		q.held = false
+	}
+}
+
+// leastLoaded picks the least-loaded passing pod, rotating among ties rather than always taking the first name.
+func (s *sim) leastLoaded(rp *replica, pods []string) string {
+	var bestTok int64 = math.MaxInt64
+	var tied []string
+	for _, p := range pods {
+		l := rp.reg.get(fullEndpointName(p))
+		switch {
+		case l.Tokens < bestTok:
+			bestTok, tied = l.Tokens, []string{p}
+		case l.Tokens == bestTok:
+			tied = append(tied, p)
+		}
+	}
+	sort.Strings(tied)
+	s.rr++
+	return tied[s.rr%len(tied)]
+}
+
+func (s *sim) handle(e *event) {
+	r := e.r
+	switch e.kind {
+	case "arrive":
+		r.enq = s.now
+		r.preparedAt = s.now
+		if s.arm == arm3173 && !s.cfg.sameWindow {
+			// The PR's preparation, tokenization included, runs while queued and is charged before release.
+			r.preparedAt = s.now + s.cfg.releaseToFilt - ms/10
+		}
+		s.enqueue(r)
+		s.dispatchCycle(s.rep(r))
+	case "tick":
+		for _, rp := range s.reps {
+			s.dispatchCycle(rp)
+		}
+		if s.pending() {
+			s.push(s.now+ms, "tick", nil)
+		}
+	case "deadline":
+		if !r.done && r.queued {
+			s.finish(r, 429)
+		}
+	case "filter":
+		if r.done {
+			return
+		}
+		rp := s.rep(r)
+		passed := s.filter(rp, r)
+		if len(passed) == 0 {
+			s.reject(r)
+			break
+		}
+		r.pod = s.leastLoaded(rp, passed)
+		if s.arm == armTryReserve {
+			s.push(s.now+s.cfg.rankToReserve, "reserve", r)
+		} else {
+			s.push(s.now+s.cfg.filtToPreReq, "prerequest", r)
+		}
+	case "reserve":
+		if r.done {
+			return
+		}
+		rp := s.rep(r)
+		// The reservation is a check-and-add on the selected endpoint with the filter's own test (detector.go admits).
+		// Single-threaded virtual time makes it atomic; a conflict means another request reserved since ranking.
+		if !rp.det.admits(rp.reg.get(fullEndpointName(r.pod)), r.cost, s.limitReq(), s.cfg.maxTok) {
+			s.conflicts++
+			s.reject(r)
+			break
+		}
+		s.addLoad(rp, r.pod, 1, r.cost)
+		r.tokReserved = true
+		s.push(s.now+s.cfg.filtToPreReq, "prerequest", r)
+	case "prerequest":
+		if r.done {
+			return
+		}
+		if !r.tokReserved {
+			s.addLoad(s.rep(r), r.pod, 1, r.cost)
+		}
+		// PreRequest consumes the endpoint reservation: from here the load counter holds the request.
+		r.tokReserved = false
+		s.releaseDispatch(r)
+		r.running = true
+		s.push(s.now+r.dur, "complete", r)
+	case "complete":
+		if r.done || !r.running {
+			return
+		}
+		r.running = false
+		s.addLoad(s.rep(r), r.pod, -1, -r.cost)
+		s.finish(r, 200)
+		s.wakeHeld(s.rep(r), wakeOnCapacity)
+	case "backoff":
+		if !r.done && r.held && r.heldAt+s.cfg.backoff <= s.now {
+			r.held = false
+		}
+	case "sample":
+		for _, rp := range s.reps {
+			s.wakeHeld(rp, wakeOnSample)
+		}
+		if s.pending() {
+			s.push(s.now+s.cfg.samplePeriod, "sample", nil)
+		}
+	case "sync":
+		s.snapshotAll()
+		if s.pending() {
+			s.push(s.now+s.cfg.syncPeriod, "sync", nil)
+		}
+	case "cancel":
+		if r.done {
+			return
+		}
+		s.releaseDispatch(r)
+		switch {
+		case r.running:
+			r.running = false
+			s.addLoad(s.rep(r), r.pod, -1, -r.cost)
+			s.wakeHeld(s.rep(r), wakeOnCapacity)
+		case r.tokReserved:
+			// A reservation taken but not yet consumed by PreRequest is rolled back exactly once.
+			r.tokReserved = false
+			s.addLoad(s.rep(r), r.pod, -1, -r.cost)
+			s.wakeHeld(s.rep(r), wakeOnCapacity)
+		}
+		s.finish(r, 499)
+	}
+}
+
+func (s *sim) limitReq() int64 {
+	if s.cfg.mode == modeTokens {
+		return math.MaxInt64
+	}
+	return s.cfg.maxReq
+}
+
+func (s *sim) pending() bool {
+	for _, r := range s.reqs {
+		if !r.done {
+			return true
+		}
+	}
+	return false
+}
+
+type result struct {
+	Scenario    string         `json:"scenario"`
+	Arm         arm            `json:"arm"`
+	Outcomes    map[string]int `json:"outcomes"`
+	Attempts    map[string]int `json:"attempts_per_request"`
+	QueueAgeMs  map[string]any `json:"queue_age_ms"`
+	BySize      map[string]any `json:"by_size,omitempty"`
+	OvershootTk int64          `json:"overshoot_max"`
+	OverMs      float64        `json:"overshoot_duration_ms"`
+	Balance     map[string]any `json:"reservation_balance"`
+	GateEvals   int            `json:"gate_evals"`
+	FilterEvals int            `json:"filter_evals"`
+	Conflicts   int            `json:"reserve_conflicts"`
+	WallUs      float64        `json:"harness_wall_us"`
+	Notes       string         `json:"notes,omitempty"`
+}
+
+func nearestRank(xs []float64, p float64) float64 {
+	if len(xs) == 0 {
+		return math.NaN()
+	}
+	sort.Float64s(xs)
+	return xs[max(1, int(math.Ceil(p/100*float64(len(xs)))))-1]
+}
+
+func (s *sim) run(scenario string, sizeSplit int64) result {
+	start := time.Now()
+	for _, r := range s.reqs {
+		if r.pinPod != "" {
+			r.pod, r.running, r.attempts = r.pinPod, true, 1
+			s.addLoad(s.rep(r), r.pinPod, 1, r.cost)
+			s.push(r.dur, "complete", r)
+			continue
+		}
+		s.push(r.arrive, "arrive", r)
+		if s.requeueArm() {
+			s.push(r.arrive+s.cfg.maxAge, "deadline", r)
+		}
+		if r.cancelAt > 0 {
+			s.push(r.cancelAt, "cancel", r)
+		}
+	}
+	if s.cfg.wake == wakeOnSample && s.cfg.samplePeriod > 0 {
+		s.push(s.cfg.samplePeriod, "sample", nil)
+	}
+	if len(s.reps) > 1 {
+		s.snapshotAll()
+		s.push(s.cfg.syncPeriod, "sync", nil)
+	}
+	s.push(ms, "tick", nil)
+	for s.events.Len() > 0 {
+		e := heap.Pop(&s.events).(*event)
+		s.now = e.at
+		s.handle(e)
+		if s.now > 600_000*ms {
+			s.t.Fatalf("%s/%s did not drain", scenario, s.arm)
+		}
+	}
+	for pod, since := range s.overSince {
+		s.overDuration += s.now - since
+		delete(s.overSince, pod)
+	}
+	wall := time.Since(start)
+
+	res := result{Scenario: scenario, Arm: s.arm, Outcomes: map[string]int{}, Attempts: map[string]int{},
+		OvershootTk: s.overMax, OverMs: float64(s.overDuration) / float64(ms), GateEvals: s.gateEvals,
+		FilterEvals: s.filterEvals, Conflicts: s.conflicts, WallUs: float64(wall.Microseconds())}
+	var ages []float64
+	bySize := map[string][]float64{}
+	bySizeOut := map[string]map[string]int{}
+	for _, r := range s.reqs {
+		if !r.done {
+			s.t.Fatalf("%s/%s: %s never finished", scenario, s.arm, r.id)
+		}
+		if r.pinPod != "" {
+			continue
+		}
+		res.Outcomes[fmt.Sprint(r.outcome)]++
+		res.Attempts[fmt.Sprint(r.attempts)]++
+		// Queue age runs from the first enqueue to the release that was served.
+		// For a request that was not served it runs to its final outcome: rejection, exhaustion or cancellation.
+		end := r.doneAt
+		if r.outcome == 200 {
+			end = r.finalRelease
+		}
+		age := float64(end-r.enq) / float64(ms)
+		ages = append(ages, age)
+		size := "small"
+		if sizeSplit > 0 && r.cost >= sizeSplit {
+			size = "large"
+		}
+		bySize[size] = append(bySize[size], age)
+		if bySizeOut[size] == nil {
+			bySizeOut[size] = map[string]int{}
+		}
+		bySizeOut[size][fmt.Sprint(r.outcome)]++
+	}
+	res.QueueAgeMs = map[string]any{"p50": nearestRank(append([]float64{}, ages...), 50),
+		"p99": nearestRank(append([]float64{}, ages...), 99), "max": nearestRank(append([]float64{}, ages...), 100)}
+	if sizeSplit > 0 {
+		res.BySize = map[string]any{}
+		for k, v := range bySize {
+			res.BySize[k] = map[string]any{"outcomes": bySizeOut[k], "queue_age_ms_p50": nearestRank(append([]float64{}, v...), 50),
+				"queue_age_ms_max": nearestRank(append([]float64{}, v...), 100)}
+		}
+	}
+	var pending int64
+	var leftover []string
+	for i, rp := range s.reps {
+		pending += rp.det.pendingDispatches.Load()
+		for _, p := range s.cfg.pods {
+			if l := rp.own[p]; l.Requests != 0 || l.Tokens != 0 {
+				leftover = append(leftover, fmt.Sprintf("replica %d %s: %d requests, %d tokens", i, p, l.Requests, l.Tokens))
+			}
+		}
+	}
+	res.Balance = map[string]any{"dispatch_reserved": s.reserve, "dispatch_released": s.release,
+		"pending_dispatches_at_end": pending, "load_left_at_end": leftover}
+	return res
+}
