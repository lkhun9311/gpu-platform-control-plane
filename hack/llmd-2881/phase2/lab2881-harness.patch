+			{id: "held", arrive: 0, cost: 300, dur: 300 * ms, cancelAt: 500 * ms},
+			{id: "queued", arrive: 1 * ms, cost: 300, dur: 300 * ms, cancelAt: 2 * ms},
+			{id: "inwindow", arrive: 1100 * ms, cost: 100, dur: 300 * ms, cancelAt: 1100*ms + 4*ms + ms/10},
+			{id: "running", arrive: 1200 * ms, cost: 100, dur: 300 * ms, cancelAt: 1300 * ms},
