+				reqs = append(reqs, &simReq{id: fmt.Sprintf("b%d-%02d", b, i), arrive: int64(b)*1500*ms + int64(i)*ms,
+					cost: 150 + int64((i*37)%250), dur: 300 * ms, replica: i % 2})
+			}
+		}
+		record(t, newSim(t, cfg, a, reqs).run("two-replicas-50ms-sync", 0))
