+// Two releases under one request id: main's detector reserves once and releases once, so the second is not counted.
+func TestLab2881DuplicateIDReservation(t *testing.T) {
+	d := newDetector("dup", config{mode: modeRequests, maxConcurrency: 4, failClosed: true}, logr.Discard())
+	first, second := d.ReserveDispatch("dup"), d.ReserveDispatch("dup")
+	t.Logf("reserve first=%v second=%v pending=%d", first, second, d.pendingDispatches.Load())
+	if !first || second || d.pendingDispatches.Load() != 1 {
+		t.Fatalf("unexpected reservation behaviour")
+	}
+	r1, r2 := d.ReleaseDispatch("dup"), d.ReleaseDispatch("dup")
+	t.Logf("release first=%v second=%v pending=%d", r1, r2, d.pendingDispatches.Load())
+	labResults = append(labResults, result{Scenario: "duplicate-id-dispatch-reservation", Arm: armBaseline,
+		Notes: fmt.Sprintf("second ReserveDispatch=%v, pending while both in flight=1, release first=%v second=%v", second, r1, r2)})
+}
