+// S5a: one request larger than the limit on an empty pod; the detector admits it as the best placement available.
+// S5b: the same request arrives while a steady stream of small requests keeps the only pod busy.
+func TestLab2881Oversized(t *testing.T) {
+	for _, v := range variants() {
+		for _, a := range allArms {
+			if !v.applies(a) {
+				continue
+			}
+			cfg := v.apply(baseCfg())
+			cfg.pods = []string{"a"}
+			var reqs []*simReq
+			for i := 0; i < 40; i++ {
+				reqs = append(reqs, &simReq{id: fmt.Sprintf("s%02d", i), arrive: int64(i) * 150 * ms, cost: 300, dur: 400 * ms})
+			}
+			reqs = append(reqs, &simReq{id: "big", arrive: 1000 * ms, cost: 1500, dur: 500 * ms})
+			record(t, newSim(t, cfg, a, reqs).run("oversized-under-steady-small-load"+v.suffix(a), 1024))
+		}
+	}
+	for _, a := range allArms {
+		cfg := baseCfg()
+		cfg.pods = []string{"a"}
+		reqs := []*simReq{{id: "big", arrive: 0, cost: 1500, dur: 500 * ms}}
+		record(t, newSim(t, cfg, a, reqs).run("oversized-empty-pod", 1024))
+	}
