+// S1: two requests race for the last room on one pod, swept over the second request's arrival offset.
+// The sweep crosses the first request's filter and PreRequest, so it covers both orders around each barrier.
+func TestLab2881RaceForLastSlot(t *testing.T) {
+	for _, window := range []int64{4 * ms, ms / 10} {
+		for _, a := range allArms {
+			outcome := map[string]int{}
+			var worst int64
+			var conflicts int
+			for off := int64(0); off <= 6*ms; off += ms / 20 {
+				cfg := baseCfg()
+				cfg.pods = []string{"a"}
+				cfg.releaseToFilt = window
+				cfg.sameWindow = true
+				reqs := []*simReq{
+					{id: "bg", cost: 524, dur: 10_000 * ms, pinPod: "a"},
+					{id: "r1", arrive: 0, cost: 500, dur: 300 * ms},
+					{id: "r2", arrive: off, cost: 500, dur: 300 * ms},
+				}
+				s := newSim(t, cfg, a, reqs)
+				res := s.run("race", 0)
+				if res.Balance["pending_dispatches_at_end"].(int64) != 0 {
+					t.Fatalf("leak: %v", res.Balance)
+				}
+				key := fmt.Sprintf("r2=%d attempts=%d overshoot=%v", reqs[2].outcome, reqs[2].attempts, res.OvershootTk > 0)
+				outcome[key]++
+				worst = max(worst, res.OvershootTk)
+				conflicts += res.Conflicts
+			}
+			b, _ := json.Marshal(outcome)
+			t.Logf("race window=%dus arm=%s offsets=121 %s worst_overshoot=%d", window, a, b, worst)
+			labResults = append(labResults, result{Scenario: fmt.Sprintf("race-window-%dus", window), Arm: a,
+				Outcomes: map[string]int{}, Notes: string(b), OvershootTk: worst, Conflicts: conflicts})
+		}
+	}
+}
