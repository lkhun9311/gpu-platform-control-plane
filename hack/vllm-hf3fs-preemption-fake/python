#!/bin/bash
# A fake python for the vLLM HF3FS preemption kit's offline test.
# It answers the kit's environment probe with an A10G that torch sees, or with no CUDA when FAKE_CUDA=0.
# `python -m pytest ...` runs the fake pytest of kit p1 in its place, and `python .../bench_preempt.py` kit p5's fake bench.
# Anything else runs on the real python3, isolated from the caller's environment.
case "${1:-}" in
  */envprobe.py)
    if [ "${FAKE_CUDA:-1}" = 1 ]; then
      echo '{"cuda_available": true, "device_count": 1, "device_name": "NVIDIA A10G", "python": "3.12.15", "torch": "fake", "torch_cuda": "fake", "triton": "fake"}'
    else
      echo '{"cuda_available": false, "device_count": 0, "device_name": null, "python": "3.12.15", "torch": "fake", "torch_cuda": null, "triton": "fake"}'
    fi
    ;;
  -m)
    [ "${2:-}" = pytest ] || { echo "fake python: only -m pytest is faked, not -m ${2:-}" >&2; exit 2; }
    shift 2
    # Kit p7's two-test file has its own fake, which tells the arms apart by the fence.
    if command grep -q 'def test_failed_gather_still_fences_its_reads' tests/v1/kv_connector/unit/test_hf3fs_preemption.py 2>/dev/null; then
      exec python3 -I -B "$(dirname "$0")/pytest_p7.py" "$@"
    fi
    exec python3 -I -B "$(dirname "$0")/pytest_p1.py" "$@"
    ;;
  */bench_preempt.py)
    # Kit p5's b1 runs the fake bench in place of the real one, which needs a GPU.
    shift
    exec python3 -I -B "$(dirname "$0")/bench_b1.py" "$@"
    ;;
  */bench_preempt_v2.py)
    # Kit p6's b2 runs the same fake bench as bench_preempt_v2.py, which also writes fix_wait.
    shift
    FAKE_BENCH_V2=1 exec python3 -I -B "$(dirname "$0")/bench_b1.py" "$@"
    ;;
  *) exec python3 -I -B "$@" ;;
esac
