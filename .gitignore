# Local AI tool workspace - do not commit
superpowers/

# docs/ is published selectively: the design documents and the specs are the substance a reader needs,
# while the implementation plans and the interview notes are working material and stay local.
docs/*
!docs/0[0-7]*.md
!docs/09*.md
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/specs/
.claude/
.cursor/
.chatgpt/
.codex/
.githooks/

# Markdown is committed selectively. The design documents and specs are published because a reader who
# clones this repository should be able to see the reasoning, not just the code; the implementation plans
# and the interview notes are working material and stay local.
*.md
!/README.md
!/infra/**/README.md
!/hack/m6-kind-e2e.md
!/hack/m5b-gateway-path.md
!/hack/chaos-fr004-degraded-node.md
!/hack/observability-kind.md
!/docs/0[0-7]*.md
!/docs/09*.md
!/docs/10_WHAT_I_GOT_WRONG.md
!/docs/superpowers/specs/*.md

# Terraform local state, cache and secrets (state lives in the remote backend, not here)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# JetBrains / IntelliJ
.idea/
*.iml
out/

# VSCode
.vscode/

# Local secrets and environment
.env
.env.*
*.local

# Local runtime state
state/
tmp/
.reviews/
*.db
*.sqlite
*.sqlite3
deployments/
evidence/

# Generated binaries
bin/
dist/
build/

# OS files
.DS_Store
Thumbs.db

# Go test artifacts
*.out
*.test

# Claude Code personal overrides
.claude/settings.local.json

