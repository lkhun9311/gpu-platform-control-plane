+def _load_until_finished(connector, request_id, block_ids, timeout=10.0):
+    """Start a load and poll get_finished until it reports the request."""
+    metadata = HF3FSConnectorMetadata()
+    metadata.add_request(
+        HF3FSRequestMetadata(
+            request_id=request_id,
+            token_ids=list(range(len(block_ids) * BLOCK_SIZE)),
+            block_ids=block_ids,
+            load_block_op=LoadBlockInfo(
+                num_computed_blocks=0,
+                num_blocks_to_load=len(block_ids),
+                need_fetch_block_ids=block_ids,
+            ),
+        )
+    )
+    connector.bind_connector_metadata(metadata)
+    connector.start_load_kv(None)
+    connector.clear_connector_metadata()
+
+    deadline = time.monotonic() + timeout
+    while True:
+        _, finished_recving = connector.get_finished(set())
+        if request_id in finished_recving:
+            return
+        assert time.monotonic() < deadline, f"load of {request_id} never finished"
+        time.sleep(0.01)
+
+
+def _raise_lookup_error(keys):
+    raise ConnectionError("metadata server unreachable")
+
+
+class TestHF3FSLoadErrors:
+    """A failed load must report its block IDs when it is reported finished."""
+
+    @pytest.mark.parametrize(
+        "get_key_locations",
+        [
+            lambda keys: [None] * len(keys),
+            _raise_lookup_error,
+            # A page past the end of the file makes the read come back short.
+            lambda keys: [NUM_FILE_PAGES] * len(keys),
+        ],
+        ids=["missing_key", "lookup_raises", "short_read"],
+    )
+    def test_failed_load_reports_block_ids(self, load_connector, get_key_locations):
+        connector, metadata = load_connector
+        metadata.get_key_locations_replies.append(get_key_locations)
+
+        _load_until_finished(connector, "req-0", [3, 5])
+
+        assert connector.get_block_ids_with_load_errors() == {3, 5}
+        # The errors are drained, so a later pass does not report them again.
+        assert connector.get_block_ids_with_load_errors() == set()
+
+    @pytest.mark.skipif(
+        not torch.cuda.is_available(),
+        reason="a successful load scatters with a Triton kernel",
+    )
+    def test_failed_batch_reported_when_last_batch_succeeds(self, load_connector):
+        connector, metadata = load_connector
+        block_ids = list(range(1, DEFAULT_MAX_IO_ENTRIES + 2))
+        # The load is split into two batches.
+        # The first batch misses and the second batch reads page 0.
+        metadata.get_key_locations_replies += [
+            lambda keys: [None] * len(keys),
+            lambda keys: [0] * len(keys),
+        ]
+
+        _load_until_finished(connector, "req-0", block_ids)
+
+        assert connector.get_block_ids_with_load_errors() == set(
+            block_ids[:DEFAULT_MAX_IO_ENTRIES]
+        )
