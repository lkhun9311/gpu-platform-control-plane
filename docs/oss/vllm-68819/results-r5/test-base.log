default_vllm_config = VllmConfig(model_config=None, cache_config=CacheConfig(block_size=64, user_specified_block_size=False, kv_cache_layout..._transfer_config=None, watchdog_config=WatchdogConfig(timeout=300, check_interval=10, dump_dir=''), shutdown_timeout=0)

    @pytest.mark.skipif(
