From 40ca3cd52b0e7327221283769c38cf868d1e7a0e Mon Sep 17 00:00:00 2001
From: lkhun9311 <96328441+lkhun9311@users.noreply.github.com>
Date: Mon, 23 Nov 2026 01:07:43 +0900
Subject: [PATCH] [Perf] mamba: Prewarm the Mamba2 prefill scan for batches
 with initial states

---
 .../attention/hybrid_linear_attn_backend.py   |  43 +++++
 .../srt/layers/attention/mamba/mamba.py       |  79 +++++++++
 .../srt/model_executor/runner/base_runner.py  |   9 +-
 .../layers/test_mamba2_prefill_prewarm.py     | 158 ++++++++++++++++++
 4 files changed, 288 insertions(+), 1 deletion(-)
 create mode 100644 test/registered/unit/layers/test_mamba2_prefill_prewarm.py

diff --git a/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py b/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
index 9373938c..a1d6c57b 100644
--- a/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
+++ b/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
@@ -1,6 +1,7 @@
 from __future__ import annotations
 
 import logging
+import time
 from typing import TYPE_CHECKING, Optional, Union
 
 import torch
@@ -1234,6 +1235,34 @@ class Mamba2AttnBackend(MambaAttnBackendBase):
             forward_batch,
         )
 
+    def prewarm_prefill_kernels(self, model: torch.nn.Module) -> None:
+        """Autotune the Mamba2 prefill scan for batches with initial states."""
+        mixers = {}
+        for module in model.modules():
+            if isinstance(module, MambaMixer2):
+                geometry = (
+                    module.num_heads // module.tp_size,
+                    module.head_dim,
+                    module.n_groups // module.tp_size,
+                    module.ssm_state_size,
+                )
+                mixers.setdefault(geometry, module)
+        if not mixers:
+            return
+        state_dtype = self.state_pool.mamba_cache.temporal.dtype
+        tic = time.perf_counter()
+        for mixer in mixers.values():
+            mixer.prewarm_prefill_kernels(
+                chunk_size=self.mamba_chunk_size,
+                dtype=self._model_runner.dtype,
+                state_dtype=state_dtype,
+            )
+        logger.info(
+            "Prewarmed the Mamba2 prefill scan for %d layer geometries in %.1f s.",
+            len(mixers),
+            time.perf_counter() - tic,
+        )
+
     def forward(
         self,
         mixer: MambaMixer2,
@@ -1929,3 +1958,17 @@ class ShortConvHybridAttnBackend(HybridLinearAttnBackend):
 
     def conv_state_metadata(self, layer_id: int, forward_batch: ForwardBatch):
         return self.short_conv_backend.conv_state_metadata(layer_id, forward_batch)
+
+
+def prewarm_mamba2_prefill_kernels(
+    *, attn_backend: AttentionBackend, model: torch.nn.Module
+) -> None:
+    """Prewarm the Mamba2 prefill scan behind a runner's attention backend."""
+    from sglang.srt.layers.attention.tbo_backend import TboAttnBackend
+
+    if isinstance(attn_backend, TboAttnBackend):
+        attn_backend = attn_backend.primary
+    if isinstance(attn_backend, HybridLinearAttnBackend) and isinstance(
+        attn_backend.linear_attn_backend, Mamba2AttnBackend
+    ):
+        attn_backend.linear_attn_backend.prewarm_prefill_kernels(model)
diff --git a/python/sglang/srt/layers/attention/mamba/mamba.py b/python/sglang/srt/layers/attention/mamba/mamba.py
index e3a2328b..d56ae6fa 100644
--- a/python/sglang/srt/layers/attention/mamba/mamba.py
+++ b/python/sglang/srt/layers/attention/mamba/mamba.py
@@ -439,6 +439,85 @@ class MambaMixer2(torch.nn.Module):
 
         self.prefix = prefix
 
+    def prewarm_prefill_kernels(
+        self, *, chunk_size: int, dtype: torch.dtype, state_dtype: torch.dtype
+    ) -> None:
+        """Run the prefill scan once without and once with initial states.
+
+        Startup batches have no cached prefix, so the scan kernels autotune with
+        the initial-state pointers set to None.
+        Serving passes them once a batch holds a chunked or prefix-cached request.
+        The Triton autotune key changes with that, so the first such batch would
+        autotune again after the server is ready.
+        """
+        local_num_heads = self.num_heads // self.tp_size
+        local_num_groups = self.n_groups // self.tp_size
+        device = self.A.device
+        # Two sequences, the second starting inside a chunk, as in a mixed batch.
+        seq_lens = [2 * chunk_size + chunk_size // 2, chunk_size + 3]
+        num_tokens = sum(seq_lens)
+        query_start_loc = torch.tensor(
+            [0, seq_lens[0], num_tokens], dtype=torch.int32, device=device
+        )
+        seq_idx = torch.repeat_interleave(
+            torch.arange(len(seq_lens), dtype=torch.int32, device=device),
+            query_start_loc.diff(),
+        ).unsqueeze(0)
+        x = torch.randn(
+            1, num_tokens, local_num_heads, self.head_dim, dtype=dtype, device=device
+        )
+        dt = torch.randn(1, num_tokens, local_num_heads, dtype=dtype, device=device)
+        B = torch.randn(
+            1,
+            num_tokens,
+            local_num_groups,
+            self.ssm_state_size,
+            dtype=dtype,
+            device=device,
+        )
+        C = torch.randn_like(B)
+        out = torch.empty_like(x)
+        chunk_indices, chunk_offsets = (
+            Mamba2Metadata._query_start_loc_to_chunk_indices_offsets(
+                query_start_loc, chunk_size, num_tokens
+            )
+        )
+        initial_states = torch.zeros(
+            len(seq_lens),
+            local_num_heads,
+            self.head_dim,
+            self.ssm_state_size,
+            dtype=state_dtype,
+            device=device,
+        )
+        for with_initial_states in (False, True):
+            # Same arguments as the prefill call in `forward`.
+            mamba_chunk_scan_combined(
+                x,
+                dt,
+                self.A,
+                B,
+                C,
+                chunk_size=chunk_size,
+                D=self.D,
+                z=None,
+                dt_bias=self.dt_bias,
+                seq_idx=seq_idx,
+                chunk_indices=chunk_indices if with_initial_states else None,
+                chunk_offsets=chunk_offsets if with_initial_states else None,
+                cu_seqlens=query_start_loc,
+                initial_states=initial_states if with_initial_states else None,
+                return_varlen_states=True,
+                return_final_states=False,
+                return_track_states=True,
+                track_seq_idx=None,
+                track_end_locs=None,
+                dt_softplus=True,
+                dt_limit=(0.0, float("inf")),
+                out=out,
+                state_dtype=state_dtype,
+            )
+
     def forward(
         self,
         *,
diff --git a/python/sglang/srt/model_executor/runner/base_runner.py b/python/sglang/srt/model_executor/runner/base_runner.py
index 536df97d..41b72f68 100644
