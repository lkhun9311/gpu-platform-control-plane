 from sglang.srt.environ import envs
 from sglang.srt.kernel_plugins.nvidia.binding import prepare_megakernel
 from sglang.srt.layers import deep_gemm_wrapper
@@ -289,6 +289,13 @@ class BaseRunner(ABC):
 
             prewarm_gdn_prefill_kernels(attn_backend=mr.attn_backend, model=mr.model)
 
+        if mamba2_config(mr.model_config) is not None:
+            from sglang.srt.layers.attention.hybrid_linear_attn_backend import (
+                prewarm_mamba2_prefill_kernels,
+            )
+
+            prewarm_mamba2_prefill_kernels(attn_backend=mr.attn_backend, model=mr.model)
+
         if should_run_flashinfer_autotune(self.model_runner):
             buffers, batch_size = self._autotune_buffers()
             assert buffers is not None, (
diff --git a/test/registered/unit/layers/test_mamba2_prefill_prewarm.py b/test/registered/unit/layers/test_mamba2_prefill_prewarm.py
new file mode 100644
index 00000000..a9d5f73a
--- /dev/null
+++ b/test/registered/unit/layers/test_mamba2_prefill_prewarm.py
@@ -0,0 +1,158 @@
+import ast
+import inspect
+import textwrap
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+import torch
+
+from sglang.kernels.ops.mamba.triton_ops import (
+    ssd_chunk_scan,
+    ssd_chunk_state,
+    ssd_state_passing,
+)
+from sglang.kernels.ops.mamba.triton_ops.ssd_combined import mamba_chunk_scan_combined
+from sglang.srt.layers.attention.mamba import mamba as mamba_module
+from sglang.srt.layers.attention.mamba.mamba import MambaMixer2
+from sglang.srt.layers.attention.mamba.mamba2_metadata import Mamba2Metadata
+from sglang.test.ci.ci_register import register_cuda_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cuda_ci(est_time=30, stage="base-b", runner_config="1-gpu-small")
+
+CHUNK_SIZE = 64
+NUM_HEADS = 8
+HEAD_DIM = 32
+N_GROUPS = 2
+STATE_SIZE = 16
+
+# The scan kernels whose autotune key depends on the initial-state pointers.
+AUTOTUNED_KERNELS = (
+    ssd_chunk_scan._chunk_scan_fwd_kernel,
+    ssd_chunk_state._chunk_state_varlen_kernel,
+    ssd_state_passing._state_passing_fwd_kernel,
+)
+
+
+def _mixer(device: str) -> SimpleNamespace:
+    """The mixer attributes the prewarm reads, without building a model."""
+    return SimpleNamespace(
+        num_heads=NUM_HEADS,
+        tp_size=1,
+        n_groups=N_GROUPS,
+        head_dim=HEAD_DIM,
+        ssm_state_size=STATE_SIZE,
+        A=-torch.rand(NUM_HEADS, device=device),
+        D=torch.ones(NUM_HEADS, device=device),
+        dt_bias=torch.ones(NUM_HEADS, device=device),
+    )
+
+
+def _prewarm(mixer, dtype=torch.bfloat16, state_dtype=torch.float32):
+    MambaMixer2.prewarm_prefill_kernels(
+        mixer, chunk_size=CHUNK_SIZE, dtype=dtype, state_dtype=state_dtype
+    )
+
+
+def _forward_scan_keywords() -> set[str]:
+    """Keyword names of the prefill scan call in MambaMixer2.forward."""
+    tree = ast.parse(textwrap.dedent(inspect.getsource(MambaMixer2.forward)))
+    calls = [
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.Call)
+        and getattr(node.func, "id", None) == "mamba_chunk_scan_combined"
+    ]
+    assert len(calls) == 1
+    return {keyword.arg for keyword in calls[0].keywords}
+
+
+class TestMamba2PrefillPrewarmCalls(CustomTestCase):
+    def test_runs_without_and_with_initial_states(self):
+        with mock.patch.object(mamba_module, "mamba_chunk_scan_combined") as scan:
+            _prewarm(_mixer("cpu"))
+
+        self.assertEqual(scan.call_count, 2)
+        without, with_states = (call.kwargs for call in scan.call_args_list)
+        for name in ("initial_states", "chunk_indices", "chunk_offsets"):
+            self.assertIsNone(without[name])
+            self.assertIsNotNone(with_states[name])
+        # The chunk metadata is what a batch with initial states gets.
+        expected = Mamba2Metadata._query_start_loc_to_chunk_indices_offsets(
+            with_states["cu_seqlens"],
+            CHUNK_SIZE,
+            int(with_states["cu_seqlens"][-1]),
+        )
+        self.assertTrue(torch.equal(with_states["chunk_indices"], expected[0]))
+        self.assertTrue(torch.equal(with_states["chunk_offsets"], expected[1]))
+
+    def test_uses_the_same_keywords_as_the_forward_scan(self):
+        with mock.patch.object(mamba_module, "mamba_chunk_scan_combined") as scan:
+            _prewarm(_mixer("cpu"))
+
+        for call in scan.call_args_list:
+            self.assertEqual(set(call.kwargs), _forward_scan_keywords())
+
+
+@unittest.skipIf(not torch.cuda.is_available(), "CUDA is required")
+class TestMamba2PrefillPrewarmAutotune(CustomTestCase):
+    def test_batch_with_initial_states_does_not_autotune_again(self):
+        for kernel in AUTOTUNED_KERNELS:
+            kernel.cache.clear()
+        mixer = _mixer("cuda")
+        _prewarm(mixer)
+        tuned = {kernel: dict(kernel.cache) for kernel in AUTOTUNED_KERNELS}
+
+        # A serving-shaped batch: a continued request and a new one.
+        seq_lens = [3 * CHUNK_SIZE + 5, 2 * CHUNK_SIZE]
+        num_tokens = sum(seq_lens)
+        query_start_loc = torch.tensor(
+            [0, seq_lens[0], num_tokens], dtype=torch.int32, device="cuda"
+        )
+        seq_idx = torch.repeat_interleave(
+            torch.arange(2, dtype=torch.int32, device="cuda"), query_start_loc.diff()
+        ).unsqueeze(0)
+        chunk_indices, chunk_offsets = (
+            Mamba2Metadata._query_start_loc_to_chunk_indices_offsets(
+                query_start_loc, CHUNK_SIZE, num_tokens
+            )
+        )
+        x = torch.randn(
+            1, num_tokens, NUM_HEADS, HEAD_DIM, dtype=torch.bfloat16, device="cuda"
+        )
+        B = torch.randn(
+            1, num_tokens, N_GROUPS, STATE_SIZE, dtype=torch.bfloat16, device="cuda"
+        )
+        mamba_chunk_scan_combined(
+            x,
+            torch.randn(1, num_tokens, NUM_HEADS, dtype=torch.bfloat16, device="cuda"),
+            mixer.A,
+            B,
+            torch.randn_like(B),
+            chunk_size=CHUNK_SIZE,
+            D=mixer.D,
+            z=None,
+            dt_bias=mixer.dt_bias,
+            seq_idx=seq_idx,
+            chunk_indices=chunk_indices,
+            chunk_offsets=chunk_offsets,
+            cu_seqlens=query_start_loc,
+            initial_states=torch.zeros(
+                2, NUM_HEADS, HEAD_DIM, STATE_SIZE, device="cuda"
+            ),
+            return_varlen_states=True,
+            return_final_states=False,
+            return_track_states=True,
+            dt_softplus=True,
+            dt_limit=(0.0, float("inf")),
+            out=torch.empty_like(x),
+            state_dtype=torch.float32,
+        )
+
+        for kernel in AUTOTUNED_KERNELS:
+            self.assertEqual(kernel.cache, tuned[kernel], kernel.fn.__name__)
+
+
+if __name__ == "__main__":
+    unittest.main()
