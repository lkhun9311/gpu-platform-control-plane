+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.third_party.flash_linear_attention.ops.index import (
+    prepare_chunk_indices,
+    prepare_chunk_offsets,
+)
+
+CHUNK_SIZE = 64
+
+
+@pytest.mark.parametrize(
+    "seq_lens",
+    [
+        [5, 0, 70],
+        [0, 70],
+        [64, 0, 0, 66],
+        [70, 0],
+        [1, 64, 65, 128],
+    ],
+)
+def test_chunk_indices_keep_ids_of_empty_sequences(seq_lens: list[int]):
+    """A zero-length sequence owns no chunk but keeps its id, so the chunks
+    of later sequences must not take it over (#68414). Each chunk row (s, i)
+    must point at chunk i of sequence s in the chunk_offsets layout."""
+    cu_seqlens = torch.tensor([0, *seq_lens], dtype=torch.int32).cumsum(0)
+    cu_seqlens = cu_seqlens.to(torch.int32)
+    chunk_indices = prepare_chunk_indices(cu_seqlens, CHUNK_SIZE).tolist()
+    chunk_offsets = prepare_chunk_offsets(cu_seqlens, CHUNK_SIZE).tolist()
+
+    expected = [
+        [seq, chunk]
+        for seq, seq_len in enumerate(seq_lens)
+        for chunk in range(-(-seq_len // CHUNK_SIZE))
+    ]
+    assert chunk_indices == expected
+    for row, (seq, chunk) in enumerate(chunk_indices):
+        assert chunk_offsets[seq] + chunk == row
